#!/usr/bin/env bash
#
# TalentSure pre-commit hook — fast local quality gate.
#
# Runs only the cheap checks that catch the majority of CI failures without an
# emulator or a full build. Heavy gates (instrumented tests, coverage, signed
# builds) stay in CI — see docs/CICD.md.
#
# Skip for a single commit with:  SKIP_HOOKS=1 git commit ...
# Installed via:                  scripts/install-git-hooks.sh
#
set -euo pipefail

if [[ "${SKIP_HOOKS:-0}" == "1" ]]; then
  echo "pre-commit: skipped (SKIP_HOOKS=1)"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Only run when Kotlin / Gradle sources are staged — docs-only commits are free.
STAGED="$(git diff --cached --name-only --diff-filter=ACMR || true)"
if ! grep -qE '\.(kt|kts|gradle)$|gradle/libs\.versions\.toml' <<<"$STAGED"; then
  echo "pre-commit: no Kotlin/Gradle changes staged — skipping checks"
  exit 0
fi

echo "pre-commit: running fast checks (domain unit tests)…"

# Pure-Kotlin domain module: no Android, no emulator — runs in a few seconds.
# This is the quick proxy for "tests pass"; the full app + coverage gate runs in CI.
if ! ./gradlew --offline --console=plain :domain:test >/tmp/precommit-domain-test.log 2>&1; then
  echo
  echo "pre-commit: ❌ :domain:test failed — commit aborted."
  echo "  See /tmp/precommit-domain-test.log (tail below):"
  tail -25 /tmp/precommit-domain-test.log
  echo
  echo "  Fix the failures, or bypass with: SKIP_HOOKS=1 git commit ..."
  exit 1
fi

echo "pre-commit: ✅ checks passed"
